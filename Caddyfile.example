# ---------------------------------------------------------------
# 方案 A：单域名（config.toml: mode = "single", public_domain = "civitai.example.com"）
# ---------------------------------------------------------------
civitai.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787 {
		# 流式透传大文件 / SSE，不缓冲
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

# ---------------------------------------------------------------
