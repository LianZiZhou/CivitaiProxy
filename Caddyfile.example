# 所有站点都反代到同一个本地端口，CivitaiProxy 按 Host 头区分站点。
(civitai_proxy) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787 {
		# 流式透传大文件 / SSE，不缓冲
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

# ---------------------------------------------------------------
# 单域名站点（config.toml 中 mode = "single"）
# ---------------------------------------------------------------
civitai.example.com, hf.example.com, gh.example.com, ghcr.example.com, docker.example.com {
	import civitai_proxy
}

# ---------------------------------------------------------------
# 泛域名站点（mode = "wildcard"），例如 HF 用 hf.example.com + *.hf.example.com：
# 泛域名证书需要 DNS-01 验证，下面以 Cloudflare DNS 插件为例
# （需使用带 caddy-dns/cloudflare 模块的 Caddy 构建）。
